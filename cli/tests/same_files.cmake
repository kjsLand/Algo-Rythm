# Runs CMD twice in two folders and fails if the files are not identical (REQ-10-5).
foreach (run 1 2)
    file(REMOVE_RECURSE "${WORK}/run${run}")
    execute_process(COMMAND ${CMD} --out "${WORK}/run${run}" RESULT_VARIABLE result)
    if (NOT result EQUAL 0)
        message(FATAL_ERROR "Run ${run} gave exit code ${result}")
    endif()
endforeach()

file(GLOB files RELATIVE "${WORK}/run1" "${WORK}/run1/*")
list(LENGTH files count)
if (count LESS 3)
    message(FATAL_ERROR "Run 1 wrote ${count} files, expected 3 or more")
endif()
foreach (name IN LISTS files)
    execute_process(COMMAND ${CMAKE_COMMAND} -E compare_files "${WORK}/run1/${name}" "${WORK}/run2/${name}" RESULT_VARIABLE different)
    if (different)
        message(FATAL_ERROR "${name} is not the same in the two runs")
    endif()
endforeach()
